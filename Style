:root {
  --jcm-orange: #E4622B;
  --jcm-orange-dark: #C24A1B;
  --jcm-red: #B0231C;
  --ink: #241C18;
  --paper: #FFFCF9;
  --line: #E8DFD6;
  --muted: #8A7E74;
  --steel: #4E5A64;
  --steel-light: #EBEEF0;
  --ok: #2E7D4F;
  --warn: #C99A2E;
  --danger: #B0231C;
  --font-display: 'Fraunces', Georgia, serif;
  --font-body: 'Inter', -apple-system, sans-serif;
  --font-mono: 'IBM Plex Mono', 'Courier New', monospace;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-body);
  min-height: 100vh;
  border-top: 3px solid;
  border-image: linear-gradient(90deg, var(--jcm-orange), var(--jcm-red)) 1;
}

.app-shell {
  max-width: 900px;
  margin: 0 auto;
  padding: 28px 20px 60px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 3px solid var(--ink);
  padding-bottom: 16px;
  margin-bottom: 28px;
}

.brand-mark {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-mark svg { flex-shrink: 0; }

.brand-text .brand {
  font-family: var(--font-display);
  font-size: 25px;
  font-weight: 600;
  letter-spacing: -0.01em;
  line-height: 1.1;
}
.brand span { color: var(--jcm-orange); }

.tagline {
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.16em;
  color: var(--muted);
  font-weight: 600;
}

nav.tabs {
  display: flex;
  gap: 4px;
  margin-bottom: 28px;
  border-bottom: 1px solid var(--line);
  overflow-x: auto;
}

nav.tabs button {
  background: none;
  border: none;
  padding: 10px 16px;
  font-family: var(--font-body);
  font-size: 13.5px;
  font-weight: 600;
  color: var(--muted);
  cursor: pointer;
  border-bottom: 2px solid transparent;
  margin-bottom: -1px;
  white-space: nowrap;
  transition: color 0.15s ease;
}

nav.tabs button:hover { color: var(--ink); }

nav.tabs button.active {
  color: var(--ink);
  border-bottom: 2px solid var(--jcm-orange);
}

.card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 24px;
  margin-bottom: 20px;
  box-shadow: 0 1px 2px rgba(36, 28, 24, 0.04);
}

h1, h2, h3 {
  font-family: var(--font-display);
  font-weight: 600;
  margin: 0 0 14px;
}

h2 { font-size: 19px; letter-spacing: -0.01em; }
h3 {
  font-size: 12px;
  color: var(--steel);
  text-transform: uppercase;
  letter-spacing: 0.09em;
  font-weight: 700;
  font-family: var(--font-body);
  border-left: 3px solid var(--jcm-orange);
  padding-left: 9px;
}

label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 6px;
  color: var(--ink);
}

input[type="text"], input[type="number"], input[type="date"], input[type="month"], input[type="password"] {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 6px;
  font-size: 14px;
  font-family: var(--font-mono);
  margin-bottom: 14px;
  background: var(--paper);
  color: var(--ink);
}

input:focus, select:focus {
  outline: 2px solid var(--jcm-orange);
  outline-offset: 1px;
  border-color: var(--jcm-orange);
}

select {
  width: 100%;
  padding: 10px 8px;
  border: 1px solid var(--line);
  border-radius: 6px;
  font-size: 13px;
  font-family: var(--font-body);
  font-weight: 600;
  background: var(--paper);
  color: var(--ink);
}

.row {
  display: grid;
  grid-template-columns: 1fr 160px;
  gap: 12px;
  align-items: center;
  margin-bottom: 10px;
}

.row-with-attendance {
  display: grid;
  grid-template-columns: 1fr 130px 112px;
  gap: 10px;
  align-items: center;
  margin-bottom: 10px;
}

.row label,
.row-with-attendance label { margin-bottom: 0; font-weight: 500; }
.row-with-attendance input, .row-with-attendance select { margin-bottom: 0; }

button.primary {
  background: var(--jcm-orange);
  color: #fff;
  border: none;
  padding: 12px 22px;
  border-radius: 7px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  font-family: var(--font-body);
  transition: background 0.15s ease, transform 0.1s ease;
}
button.primary:hover { background: var(--jcm-orange-dark); }
button.primary:active { transform: translateY(1px); }

button.secondary {
  background: none;
  border: 1.5px solid var(--ink);
  color: var(--ink);
  padding: 10px 20px;
  border-radius: 7px;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease;
}
button.secondary:hover { background: var(--steel-light); }

button.whatsapp {
  background: #25D366;
  color: #fff;
  border: none;
  padding: 12px 22px;
  border-radius: 7px;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s ease;
}
button.whatsapp:hover { background: #1EB955; }

table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

th {
  text-align: left;
  padding: 10px 10px;
  border-bottom: 2px solid var(--ink);
  font-size: 10.5px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--steel);
  background: var(--steel-light);
  font-weight: 700;
}
th:first-child { border-top-left-radius: 5px; }
th:last-child { border-top-right-radius: 5px; }

td {
  padding: 10px 10px;
  border-bottom: 1px solid var(--line);
  font-family: var(--font-mono);
}
td:first-child { font-family: var(--font-body); font-weight: 500; }

tr.total-row td {
  font-weight: 700;
  border-top: 2px solid var(--ink);
  border-bottom: none;
  font-family: var(--font-mono);
}
tr.total-row td:first-child { font-family: var(--font-body); }

.badge {
  display: inline-block;
  padding: 2px 9px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
  font-family: var(--font-body);
}
.badge.ok { background: #E4F3EA; color: var(--ok); }
.badge.warn { background: #FBF1DD; color: var(--warn); }
.badge.danger { background: #FBE6E4; color: var(--danger); }

.msg {
  padding: 10px 14px;
  border-radius: 6px;
  font-size: 13px;
  margin-bottom: 14px;
}
.msg.success { background: #E4F3EA; color: var(--ok); }
.msg.error { background: #FBE6E4; color: var(--danger); }

.summary-box {
  background: var(--ink);
  color: var(--paper);
  border-radius: 10px;
  padding: 20px;
  font-family: var(--font-mono);
  font-size: 13px;
  white-space: pre-wrap;
  line-height: 1.65;
  margin-bottom: 16px;
  border-left: 4px solid var(--jcm-orange);
}

.login-wrap {
  max-width: 340px;
  margin: 90px auto 0;
  text-align: center;
}

.login-mark {
  display: flex;
  justify-content: center;
  margin-bottom: 6px;
  opacity: 0.9;
}

.hidden { display: none !important; }

.actions { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }

.muted-small { color: var(--muted); font-size: 12px; margin-top: -6px; margin-bottom: 14px; line-height: 1.5; }

@media (max-width: 600px) {
  .row { grid-template-columns: 1fr 110px; }
  .row-with-attendance { grid-template-columns: 1fr 90px 96px; }
}
